# ---------------------------------------------------------------------------
# HireGrid — server environment
#
# Copy this file to `.env` in the same folder and fill in the values.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# `.env` is gitignored and must never be committed. This file is the committed
# template, so it must never contain a real secret.
# Every variable here is validated at startup by src/config/env.ts — the server
# refuses to boot if one is missing or malformed.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the API listens on. The client's VITE_API_URL must point at this.
PORT=4000

# PostgreSQL connection string.
# These credentials must match the postgres service in docker-compose.yml.
DATABASE_URL=postgresql://hiregrid:hiregrid_dev_password@localhost:5432/hiregrid?schema=public

# Redis connection string — used for response caching and as the BullMQ backend.
REDIS_URL=redis://localhost:6379

# Secret used to sign JWTs. Minimum 32 characters, enforced at startup.
# Generate a real one instead of using this placeholder:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars

# Google Gemini API key — free tier is sufficient.
# Create one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini model the analysis worker calls. Optional — this is the default.
# Change it here if a model is retired or your key lacks access to it.
GEMINI_MODEL=gemini-3.5-flash-lite

# Origin the browser loads the frontend from. Used as the CORS allowed origin,
# so it must match exactly (scheme, host, port — no trailing slash).
CLIENT_URL=http://localhost:5173
