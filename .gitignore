# ---------------------------------------------------------------------------
# HireGrid — repository-wide ignore rules
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment files — these hold real secrets (JWT signing key, Gemini API key,
# database password) and must never be committed. The .env.example templates in
# client/ and server/ are committed instead, and are force-included below.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example

# Build output
dist/
build/
*.tsbuildinfo
.vite/

# Uploaded resumes — user data, not source code
server/uploads/

# Prisma generated client (regenerated by `prisma generate` on every install)
server/src/generated/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage output
coverage/
.nyc_output/

# Editor and OS files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Assistant/tool output folders — not part of the project source
Claude outputs/

# Personal engineering journal - kept locally, not published
BUILD_LOG.md

# Scratch folder from a local git cleanup
_to_delete/
