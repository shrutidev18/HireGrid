# ---------------------------------------------------------------------------
# HireGrid — client environment
#
# Copy this file to `.env` in the same folder:
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to browser code. Vite enforces
# that prefix so a server secret cannot be leaked into the bundle by accident —
# never put an API key or database URL in this file.
#
# Vite inlines these at BUILD time, so restart `npm run dev` after changing one.
# ---------------------------------------------------------------------------

# Base URL of the HireGrid API. Must match the server's PORT, and must have no
# trailing slash.
VITE_API_URL=http://localhost:4000
